{
  "rules": {
    ".read": false,
    ".write": false,
    "config": {
      "events": {
        ".read": true,
        ".write": false
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !newData.exists()",
        "v2": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['dataVersion', 'saveRevision']) && newData.child('dataVersion').isNumber() && newData.child('saveRevision').isNumber()"
        }
      }
    },
    "purchases": {
      "$key": {
        ".read": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
        ".write": "auth != null && newData.exists() && newData.child('uid').val() === auth.uid && ((!data.exists() && newData.child('granted').val() === false) || (data.child('uid').val() === auth.uid && newData.child('product').val() === data.child('product').val() && newData.child('at').val() === data.child('at').val() && newData.child('granted').val() === true))",
        ".validate": "$key.length === 64 && $key.matches(/^[0-9a-f]+$/) && newData.hasChildren(['uid', 'product', 'granted', 'at'])",
        "uid": {
          ".validate": "newData.isString()"
        },
        "product": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "granted": {
          ".validate": "newData.isBoolean()"
        },
        "at": {
          ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "transfers": {
      "$code": {
        ".read": "auth != null && data.exists() && data.child('createdAt').val() > now - 86400000",
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists()))",
        ".validate": "$code.length === 12 && $code.matches(/^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]+$/) && newData.hasChildren(['uid', 'save', 'createdAt'])",
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "save": {
          ".validate": "newData.isString() && newData.val().length < 200000"
        },
        "createdAt": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
